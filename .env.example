# ---------------------------------------------------------------------------
# claude-code-api configuration
# Copy to .env and edit. Everything here has a working default except the keys.
# ---------------------------------------------------------------------------

# --- Authentication to Anthropic -------------------------------------------
# Your Claude subscription, as a long-lived token. Create it on any machine
# where you are logged in:
#
#     claude setup-token
#
# and paste the result here. Alternatively, mount a ~/.claude directory that is
# already logged in (see README) and leave this empty.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Who may call this gateway ---------------------------------------------
# Comma-separated name:key pairs. Generate keys with:
#     node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# For per-key limits and agent scoping use API_KEYS_FILE instead (see README).
API_KEYS=glasses:CHANGE_ME_1,vpnbot:CHANGE_ME_2

# Separate key with access to /metrics and /v1/sessions. Leave empty to disable.
ADMIN_KEY=

# Set to 1 ONLY if the port is unreachable from the internet. Anyone who can
# reach an anonymous gateway can spend your Claude plan.
ALLOW_ANONYMOUS=0

# --- Network ---------------------------------------------------------------
PORT=8787
# Host interface Docker publishes on. 127.0.0.1 keeps it private; put a TLS
# proxy in front before changing this (see docker-compose.tls.yml).
BIND=127.0.0.1
# Set when running behind nginx/Caddy so per-client IPs are logged correctly.
TRUST_PROXY=0
# Browser origins allowed to call the API directly, comma separated. Empty = none.
CORS_ORIGINS=

# For docker-compose.tls.yml
DOMAIN=
ACME_EMAIL=

# --- Behaviour -------------------------------------------------------------
# Which agent profile answers when the caller does not name one.
DEFAULT_AGENT=default
# Model alias used by profiles that do not pin one: opus | sonnet | haiku
DEFAULT_MODEL=sonnet
AGENTS_FILE=config/agents.json

# Treat the OpenAI `user` field as a conversation id. Useful behind chat UIs
# that cannot send a custom header.
CONVERSATION_FROM_USER_FIELD=0

# --- Throughput and safety rails -------------------------------------------
# Turns run at once. A subscription is one small shared resource: 1-3 is sane.
MAX_CONCURRENCY=2
# Requests allowed to wait for a free slot before callers get 503.
QUEUE_MAX=64
QUEUE_TIMEOUT_MS=120000
# Hard stop for a single turn.
TURN_TIMEOUT_MS=300000
# How long a freshly spawned CLI process gets to become ready. Raise it on a
# small or cold VPS where the first start is slow.
STARTUP_TIMEOUT_MS=60000

# Per-API-key limits enforced by this gateway.
RATE_LIMIT_RPM=30
RATE_LIMIT_DAILY=0

# Refuse new work above this fraction of the Claude plan window (0-1), so an
# automated client cannot burn the whole window and lock you out of Claude.
USAGE_GUARD=0.98
USAGE_GUARD_WEEKLY=0.99

# Conversation processes: how long an idle one stays warm, and how many
# conversations to remember at once.
SESSION_IDLE_MS=600000
MAX_SESSIONS=32

MAX_INPUT_CHARS=60000
MAX_IMAGES_PER_REQUEST=4
MAX_BODY_BYTES=12582912

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info
# Never on by default: this would write user messages to your container logs.
LOG_PROMPTS=0
# Serve /metrics without the admin key (only if the port is private).
PUBLIC_METRICS=0

# --- Docker ----------------------------------------------------------------
MEM_LIMIT=2g
CLAUDE_CODE_VERSION=latest
